<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64EC"><Configuration>Release</Configuration><Platform>ARM64EC</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{60DE16D7-E7EC-4A56-91DF-D12202536E83}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- This must be a project property (not only ClCompile metadata):
       MSBuild uses it to select Spectre-mitigated CRT library directories. -->
  <PropertyGroup>
    <SpectreMitigation Condition="'$(PlatformToolset)' != 'ClangCL'">Spectre</SpectreMitigation>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\build\$(Platform)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\build\publisher-obj\$(Platform)\</IntDir>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Keep MSVC TU parallelism bounded; MSBuild separately schedules project references. -->
    <DoujinCompilerJobs Condition="'$(DoujinCompilerJobs)' == ''">2</DoujinCompilerJobs>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <WarningLevel Condition="'$(PlatformToolset)' == 'ClangCL'">Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <ExceptionHandling>Sync</ExceptionHandling>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <SDLCheck>true</SDLCheck>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <!-- MSVC ARM64EC: real /Qspectre and Spectre CRT; ClangCL uses LLVM SLH below. -->
      <SpectreMitigation Condition="'$(PlatformToolset)' != 'ClangCL'">Spectre</SpectreMitigation>
      <!-- Make MSVC /Qspectre explicit and independently visible in PDB command lines. -->
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\build\generated\$(Platform);$(MSBuildProjectDirectory)\build\generated\$(Platform)\sqlite;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NDEBUG;NOMINMAX;UTF8PROC_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/ZH:SHA_256 /utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- LLVM x86/x64 speculative-load hardening; clang-cl /Qspectre is ignored. -->
      <AdditionalOptions Condition="'$(PlatformToolset)' != 'ClangCL'">/Qspectre %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(PlatformToolset)' != 'ClangCL'">/MP$(DoujinCompilerJobs) /FS %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(PlatformToolset)' == 'ClangCL'">-mspeculative-load-hardening %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <TreatLinkerWarningAsErrors>true</TreatLinkerWarningAsErrors>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <CETCompat Condition="'$(Platform)' == 'x64'">true</CETCompat>
      <AdditionalOptions Condition="'$(Platform)' == 'x64'">/CETCOMPAT %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(GITHUB_ACTIONS)' == 'true'">/SOURCELINK:&quot;$(MSBuildProjectDirectory)\build\generated\$(Platform)\sourcelink-$(MSBuildProjectName).json&quot; %(AdditionalOptions)</AdditionalOptions>
      <!-- Explicit release MSVC link paths: Spectre variants must win over regular CRT. -->
      <AdditionalLibraryDirectories Condition="'$(PlatformToolset)' != 'ClangCL' and '$(Platform)' == 'Win32'">$(VCToolsInstallDir)lib\spectre\x86;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories Condition="'$(PlatformToolset)' != 'ClangCL' and '$(Platform)' == 'x64'">$(VCToolsInstallDir)lib\spectre\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- ARM64EC: prefer mitigated ARM64 import CRT archives; actual member ABI and BA2024 must still qualify. -->
      <AdditionalLibraryDirectories Condition="'$(PlatformToolset)' != 'ClangCL' and '$(Platform)' == 'ARM64EC'">$(VCToolsInstallDir)lib\spectre\arm64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- Prefer Spectre-mitigated MSVC CRT/STL when ClangCL links Windows code. -->
      <AdditionalLibraryDirectories Condition="'$(PlatformToolset)' == 'ClangCL' and '$(Platform)' == 'Win32'">$(VCToolsInstallDir)lib\spectre\x86;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories Condition="'$(PlatformToolset)' == 'ClangCL' and '$(Platform)' == 'x64'">$(VCToolsInstallDir)lib\spectre\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <SubSystem>Console</SubSystem><ControlFlowGuard>Guard</ControlFlowGuard>
      <AdditionalDependencies>shlwapi.lib;winhttp.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalDependencies Condition="'$(DoujinVerifiedSqlitePilot)' == 'true'">$(MSBuildProjectDirectory)\build\shared-lib\$(Platform)\doujinstyle_sqlite.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="publish_references.cpp" />
    <ClCompile Include="worker_build_identity.cpp" />
    <ClCompile Include="descriptor.cpp" />
    <ClCompile Include="third_party\utf8proc\utf8proc.c">
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="sqlite_shared.vcxproj" Condition="'$(DoujinVerifiedSqlitePilot)' != 'true'">
      <Project>{F2C8C46A-35FC-4BD6-AF32-E265929DFA72}</Project>
      <LinkLibraryDependencies>true</LinkLibraryDependencies>
      <UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Isolated experiment only: the workflow verifies a same-run artifact before invoking MSBuild. -->
  <Target Name="ValidateVerifiedSqlitePilot" BeforeTargets="PrepareForBuild" Condition="'$(DoujinVerifiedSqlitePilot)' == 'true'">
    <Error Condition="'$(GITHUB_ACTIONS)' != 'true' or '$(SQLITE_CACHE_PILOT)' != '1' or '$(Platform)' != 'x64' or '$(Configuration)' != 'Release' or '$(PlatformToolset)' != 'v143' or '$(VCToolsVersion)' != '14.44.35207' or '$(WindowsTargetPlatformVersion)' != '10.0.26100.0'" Text="Verified SQLite input is restricted to the isolated pinned x64 pilot." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\build\shared-lib\$(Platform)\doujinstyle_sqlite.lib')" Text="Verified SQLite library missing." />
  </Target>
  <Target Name="ValidateCompilerJobs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DoujinCompilerJobs)' != '1' and '$(DoujinCompilerJobs)' != '2' and '$(DoujinCompilerJobs)' != '4'" Text="DoujinCompilerJobs must be 1, 2 or 4." />
  </Target>
  <Target Name="GenerateBuildIdentity" BeforeTargets="ClCompile">
    <Exec Command="py -3 &quot;$(MSBuildProjectDirectory)\..\tools\build_identity.py&quot; --header &quot;$(MSBuildProjectDirectory)\build\generated\$(Platform)\doujinstyle_build_version.hpp&quot;" />
  </Target>
  <Target Name="EmitSourceLink" BeforeTargets="Link" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <Exec Command="py -3 &quot;$(MSBuildProjectDirectory)\..\tools\source_link.py&quot; --repo-root &quot;$(MSBuildProjectDirectory)\..&quot; --output &quot;$(MSBuildProjectDirectory)\build\generated\$(Platform)\sourcelink-$(MSBuildProjectName).json&quot;" />
  </Target>
</Project>
